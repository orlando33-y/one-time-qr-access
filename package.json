{
  "name": "qr-yon-sel-fwa",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev static --binding SESSION_COOKIE_SECURE=false",
    "deploy": "wrangler pages deploy static --project-name qr-yon-sel-fwa",
    "d1:create": "wrangler d1 create qr-codes --update-config",
    "d1:migrate:local": "wrangler d1 migrations apply qr-codes --local",
    "d1:migrate:remote": "wrangler d1 migrations apply qr-codes --remote",
    "pages:create": "wrangler pages project create qr-yon-sel-fwa --production-branch main"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
